rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.ownerId == uid;
      allow delete: if owns(uid);

      match /conversations/{conversationId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.ownerId == uid
          && request.resource.data.conversation_id == conversationId;
        allow delete: if owns(uid);

        match /messages/{messageId} {
          allow read: if owns(uid);
          allow create, update: if owns(uid)
            && request.resource.data.ownerId == uid
            && request.resource.data.message_id == messageId
            && request.resource.data.conversation_id == conversationId;
          allow delete: if owns(uid);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
