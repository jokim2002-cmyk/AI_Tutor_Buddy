# Public Firebase client configuration. Do not put service-account JSON/private keys here.
GYANVERSE_FIREBASE_PROJECT_ID=your-firebase-project-id
GYANVERSE_FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Google OAuth Web client used by Flet page.login(). Keep the client secret outside Git.
GYANVERSE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GYANVERSE_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GYANVERSE_OAUTH_PORT=8550
GYANVERSE_GOOGLE_REDIRECT_URL=http://localhost:8550/oauth_callback

# Required only for encrypted "Remember me" token persistence.
# Generate a long random value and keep it outside Git.
GYANVERSE_AUTH_STORAGE_SECRET=replace-with-a-long-random-local-secret
